{
  "_комментарий": "BendeRadio для Orange Pi One. Здесь станции, Wi-Fi и пины. Перезапуск: systemctl restart benderadio",

  "wifi": {
    "enabled": true,
    "ssid": "NewBuilding",
    "password": "MMH_new2023",
    "interface": "wlan0",
    "country": "RU",
    "connect_on_start": true
  },

  "radio": {
    "station": 0,
    "volume": 10,
    "volume_steps": 21,
    "stations": [
     
      { "name": "Европа Плюс",       "url": "https://europaplus.hostingradio.ru:8030/ep128" }
      
    ]
  },

  "audio": {
    "device": "default",
    "sample_rate": 44100,
    "channels": 2,
    "buffer_us": 400000,
    "chunk_seconds": 0.02,
    "ffmpeg": "ffmpeg",
    "aplay": "aplay",
    "volume_control": "amixer",
    "amixer_card": "",
    "amixer_control": "PCM"
  },

  "matrix": {
    "_driver_как_выбрать": "sysfs — без overlay, пины дёргаются программно (нужен /sys/class/gpio и root). spi — если включён overlays=spi-spidev и есть /dev/spidev0.0. Провода и пины в обоих случаях одни и те же: PC0/PC2/PC3.",
    "driver": "spi",
    "reverse": false,
    "_reverse": "true — если цепочка модулей идёт справа-налево (лицо зеркальное)",
    "modules": 5,
    "brightness": [2, 2, 2, 5, 5],
    "gpio": { "chip": "gpiochip0", "cs": 67, "din": 64, "clk": 66, "half_period_us": 4 },
    "spi": { "bus": 0, "device": 0, "speed_hz": 1000000 }
  },

  "encoder": {
    "_про_подтяжки": "sysfs не включает внутренние pull-up: если кнопка/энкодер глючит — резисторы 10к на 3.3В (пины 1/17) или driver=gpiod (python3-libgpiod)",
    "driver": "sysfs",
    "chip": "gpiochip0",
    "a": 6,
    "b": 1,
    "button": 0,
    "button_active_low": true,
    "debounce": 0.02,
    "click_timeout": 0.35,
    "hold_time": 1.2
  },

  "ui": {
    "state": true,
    "brightness_mouth": 2,
    "brightness_eyes": 5,
    "analyzer_mode": 0,
    "noise_threshold": 20,
    "eye_interval": 0.15,
    "analyzer_interval": 1.0,
    "angry_timeout": 0.8,
    "level": {
      "db_floor": -60,
      "threshold": 20,
      "attack": 0.55,
      "release": 0.12,
      "pulse_min": 30,
      "pulse_max": 80
    }
  },

  "storage": {
    "state_file": "/var/lib/benderadio/state.json"
  },

  "logging": {
    "level": "INFO"
  }
}
