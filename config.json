{
  "_комментарий": "BendeRadio для Orange Pi One. Здесь станции, Wi-Fi и пины. Перезапуск: systemctl restart benderadio",

  "wifi": {
    "enabled": true,
    "ssid": "NewBuilding",
    "password": "MMH_new2023",
    "interface": "wlan0",
    "country": "RU",
    "connect_on_start": true
  },

  "radio": {
    "station": 0,
    "volume": 10,
    "volume_steps": 21,
    "stations": [
      { "name": "Radio 1 Rock",      "url": "http://stream81.metacast.eu/radio1rock128" },
      { "name": "Европа Плюс",       "url": "https://ep128.hostingradio.ru:8030/ep128" },
      { "name": "Наше Радио",        "url": "http://nashe1.hostingradio.ru/nashe-128.mp3" },
      { "name": "Radio Paradise",    "url": "https://stream.radioparadise.com/mp3-192" },
      { "name": "NPO Radio 1",       "url": "http://icecast.omroep.nl/radio1-bb-mp3" },
      { "name": "Majestic Jukebox",  "url": "https://uk3.internet-radio.com/proxy/majesticjukebox?mp=/live" }
    ]
  },

  "audio": {
    "device": "default",
    "sample_rate": 44100,
    "channels": 2,
    "buffer_us": 400000,
    "chunk_seconds": 0.02,
    "ffmpeg": "ffmpeg",
    "aplay": "aplay",
    "volume_control": "amixer",
    "amixer_card": "",
    "amixer_control": "PCM"
  },

  "matrix": {
    "driver": "sysfs",
    "modules": 5,
    "brightness": [2, 2, 2, 5, 5],
    "gpio": { "chip": "gpiochip0", "cs": 67, "din": 64, "clk": 66, "half_period_us": 4 },
    "spi": { "bus": 0, "device": 0, "speed_hz": 1000000 }
  },

  "encoder": {
    "driver": "sysfs",
    "chip": "gpiochip0",
    "a": 6,
    "b": 1,
    "button": 0,
    "button_active_low": true,
    "debounce": 0.02,
    "click_timeout": 0.35,
    "hold_time": 1.2
  },

  "ui": {
    "state": true,
    "brightness_mouth": 2,
    "brightness_eyes": 5,
    "analyzer_mode": 0,
    "noise_threshold": 20,
    "eye_interval": 0.15,
    "analyzer_interval": 1.0,
    "angry_timeout": 0.8,
    "level": {
      "db_floor": -60,
      "threshold": 20,
      "attack": 0.55,
      "release": 0.12,
      "pulse_min": 30,
      "pulse_max": 80
    }
  },

  "storage": {
    "state_file": "/var/lib/benderadio/state.json"
  },

  "logging": {
    "level": "INFO"
  }
}
